      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://127.0.0.1:8000/genai/ask?query=What is LangGraph?",
          "protocol": "http",
          "host": [
            "127",
            "0",
            "0",
            "1"
          ],
          "port": "8000",
          "path": [
            "genai",
            "ask"
          ],
          "query": [
            {
              "key": "query",
              "value": "What is LangGraph?",
              "description": "The question you want to ask the Generative AI model."
